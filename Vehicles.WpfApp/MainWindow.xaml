<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="Vehicles.WpfApp.MainWindow"
    Title="Vehicles"
    Height="700"
    Width="1100"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">  

            <Label Content="Automark:"
                   FontWeight="Bold"/>

            <TextBox x:Name="MakeTextBox"
                     Width="130"
                     MaxLength="15"
                     PreviewTextInput="TextBox_PreviewTextInput"
                     Margin="0,0,10,0"/>

            <Label Content="Mudel:"
                   FontWeight="Bold"/>

            <TextBox x:Name="ModelTextBox"
                     Width="130"
                     MaxLength="15"
                     PreviewTextInput="TextBox_PreviewTextInput"
                     Margin="0,0,10,0"/>

            <Label Content="Transpordiliik:"
                   FontWeight="Bold"/>

            <ComboBox x:Name="VehicleTypeComboBox"
                      Width="180"
                      Margin="0,0,10,0"/>

            <Button Content="Lisa sõiduk"
                    Width="120"
                    Click="AddVehicle_Click"
                    FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Label Content="Vahemaa:"
                   FontWeight="Bold"/>

            <TextBox x:Name="DistanceTextBox"
                     Width="100"
                     Margin="0,0,10,0"/>

            <Button x:Name="MoveButton"
                    Content="Liiguta"
                    Width="90"
                    Click="Move_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="DriveButton"
                    Content="Sõida"
                    Width="90"
                    Click="Drive_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="SwimButton"
                    Content="Uju"
                    Width="90"
                    Click="Swim_Click"
                    Margin="0,0,10,0"/>

            <Button Content="Eemalda sõiduk"
                    Width="130"
                    Click="DeleteVehicle_Click"/>
        </StackPanel>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Autode garaaž"
                      Margin="0,0,8,0">

                <DataGrid x:Name="CarGarageDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="CarGarageDataGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Automark"
                                            Binding="{Binding Make}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Mudel"
                                            Binding="{Binding Model}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Transpordiliik"
                                            Binding="{Binding VehicleType}"
                                            Width="*"/>

                        <DataGridTextColumn Header="km"
                                            Binding="{Binding Odometer, StringFormat=\{0:F1\}}"
                                            Width="80"/>

                        <DataGridTemplateColumn Header="Tuled"
                                                Width="60">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="●"
                                               FontSize="20"
                                               HorizontalAlignment="Center">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding LightsOn}"
                                                                 Value="True">

                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Paatide garaaž"
                      Margin="8,0,0,0">

                <DataGrid x:Name="BoatGarageDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="BoatGarageDataGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Automark"
                                            Binding="{Binding Make}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Mudel"
                                            Binding="{Binding Model}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Transpordiliik"
                                            Binding="{Binding VehicleType}"
                                            Width="*"/>

                        <DataGridTextColumn Header="km"
                                            Binding="{Binding Odometer, StringFormat=\{0:F1\}}"
                                            Width="80"/>

                        <DataGridTemplateColumn Header="Tuled"
                                                Width="60">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <TextBlock Text="●"
                                               FontSize="20"
                                               HorizontalAlignment="Center">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding LightsOn}"
                                                                 Value="True">

                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </GroupBox>

        </Grid>

        <GroupBox Grid.Row="3"
                  Header="Valitud sõiduk"
                  Margin="0,10,0,0">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,0,10,0">

                    <TextBlock x:Name="SelectedVehicleTextBlock"
                               Text="Sõidukit ei ole valitud."
                               TextWrapping="Wrap"/>

                </Border>

                <GroupBox Grid.Column="1"
                          Header="Sõiduki logi">

                    <ListBox x:Name="VehicleLogListBox"
                             BorderThickness="0"/>

                </GroupBox>

            </Grid>

        </GroupBox>

    </Grid>

</Window>