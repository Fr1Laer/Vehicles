<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Label Content="Automark:" FontWeight="Bold"/>

            <TextBox x:Name="MakeTextBox"
                     Width="130"
                     MaxLength="15"
                     PreviewTextInput="TextBox_PreviewTextInput"
                     Margin="0,0,10,0"/>
            <Label Content="Mudel:" FontWeight="Bold"/>

            <TextBox x:Name="ModelTextBox"
                     Width="130"
                     MaxLength="15"
                     PreviewTextInput="TextBox_PreviewTextInput"
                     Margin="0,0,10,0"/>
            <Label Content="Transpordiliik:" FontWeight="Bold"/>

            <ComboBox x:Name="VehicleTypeComboBox"
                      Width="180"
                      Margin="0,0,10,0"/>

            <Button Content="Lisa sõiduk"
                    Width="120"
                    Click="AddVehicle_Click" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Label Content="Vahemaa:" FontWeight="Bold"/>

            <TextBox x:Name="DistanceTextBox"
                     Width="100"
                     Margin="0,0,10,0"/>

            <Button x:Name="MoveButton"
                    Content="Liiguta"
                    Width="90"
                    Click="Move_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="DriveButton"
                    Content="Sõida"
                    Width="90"
                    Click="Drive_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="SwimButton"
                    Content="Uju"
                    Width="90"
                    Click="Swim_Click"
                    Margin="0,0,10,0"/>

            <Button Content="Eemalda sõiduk"
                    Width="130"
                    Click="DeleteVehicle_Click"/>
        </StackPanel>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="VehicleDataGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="VehicleDataGrid_SelectionChanged"
                      Margin="0,0,15,0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Automark"
                                        Binding="{Binding Make}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Mudel"
                                        Binding="{Binding Model}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Transpordiliik"
                                        Binding="{Binding VehicleType}"
                                        Width="*"/>

                    <DataGridTextColumn Header="km"
                                        Binding="{Binding Odometer, StringFormat={}{0:F1}}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

            <GroupBox Grid.Column="1"
                      Header="Valitud sõiduk"
                      Margin="0">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock x:Name="SelectedVehicleTextBlock"
                                       Text="Sõidukit ei ole valitud."
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <GroupBox Grid.Row="1"
                              Header="Sõiduki logi">

                        <ListBox x:Name="VehicleLogListBox"
                                 BorderThickness="0"/>

                    </GroupBox>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>